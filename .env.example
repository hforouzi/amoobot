# Reference list of the environment variables Amoobot reads. Values intentionally empty.
#
# - .env (committed) holds the non-secret defaults and is loaded first. Keep secrets OUT of it.
# - Local development: put your values in .env.local (git-ignored).
# - Production: see .env.prod.example and docs/fa/deployment.md (deploy.sh writes the server env).

###> symfony/framework-bundle ###
APP_ENV=
APP_SECRET=
APP_SHARE_DIR=
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL=
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=
###< symfony/messenger ###

###> app/telegram ###
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# webhook | long_polling
TELEGRAM_MODE=
TELEGRAM_PROXY=
###< app/telegram ###

###> app/payment ###
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
PAYMENT_DESCRIPTION=
###< app/payment ###

###> app/admin ###
APP_DEFAULT_LOCALE=
###< app/admin ###

###> app/panel_proxy ###
PANEL_PROXY_ENABLED=
PANEL_PROXY_TYPE=
PANEL_PROXY_HOST=
PANEL_PROXY_PORT=
PANEL_PROXY_USERNAME=
PANEL_PROXY_PASSWORD=
PANEL_PROXY_TIMEOUT=
###< app/panel_proxy ###

###> app/service_notifications ###
SERVICE_NOTIFY_EXPIRY_DAYS=
SERVICE_NOTIFY_TRAFFIC_THRESHOLDS=
###< app/service_notifications ###

###> app/renewal_policy ###
RENEWAL_CARRY_REMAINING_TRAFFIC=
RENEWAL_CARRY_REMAINING_DAYS=
RENEWAL_EXPIRED_START_FROM_NOW=
###< app/renewal_policy ###

###> app/pricing ###
PRICING_GLOBAL_DISCOUNT_PERCENT=
TRAFFIC_ADDON_ENABLED=
TRAFFIC_ADDON_MIN_GB=
TRAFFIC_ADDON_MAX_GB=
TRAFFIC_ADDON_PRICE_PER_GB=
###< app/pricing ###
