# Amoobot production settings - TEMPLATE ONLY. Never put real values in this file or commit them anywhere.
#
# On the server:
#   sudo install -d -m 700 /etc/amoobot
#   sudo install -m 600 -o root -g root .env.prod.example /etc/amoobot/.env.prod.local
#   sudo nano /etc/amoobot/.env.prod.local          # fill in, then: sudo bash /root/deploy.sh (first deploy)
#                                                   # later: sudo amoobot-deploy
#
# This file is the ONLY supported place for secrets. Do not pass them as "sudo VAR=... amoobot-deploy": that leaks
# them into shell history, sudo logs and the environment of every child process (sudo also drops them by default).
#
# Format: KEY=VALUE, one per line; quotes optional; no ${VAR} interpolation, no inline comments.
# deploy.sh reads this file, refuses to run if a required value is missing, and writes the app's
# .env.prod.local / .env.local.php (both outside git). Generate secrets with: openssl rand -hex 32
# See docs/fa/deployment.md.

###> server / deploy (read by deploy.sh only, not passed to the app) ###
# REQUIRED. Public hostname; its DNS A record must point at this server before the first deploy (HTTPS).
DOMAIN=
# Let's Encrypt account e-mail (expiry notices). Default: admin@DOMAIN
LETSENCRYPT_EMAIL=
# Branch or tag on origin (or a full commit hash contained in one) to deploy. Default: main. --ref X overrides it.
DEPLOY_REF=
# Git URL (git@... or ssh://...). Default: git@github.com:hforouzi/amoobot.git. Root fetches it into a root-owned mirror
# with a root-owned read-only deploy key (/etc/amoobot/repo_deploy_ed25519, generated by deploy.sh).
REPO_URL=
# Optional: "yes" = deploy only annotated tags signed by a key in /etc/amoobot/allowed_signers (git verify-tag, SSH
# signatures). Without it, anyone who can push to origin can get code run as root through the deploy user.
REQUIRE_SIGNED_TAG=
# Non-root user that owns the code. Default: deploy
DEPLOY_USER=
# Your SSH public key: ONE line from your .pub file (ssh-ed25519 AAAA... you@laptop), checked with ssh-keygen. It goes
# to DEPLOY_USER's authorized_keys (root's keys are added too); it does not change how root or anyone else logs in.
DEPLOY_SSH_PUBLIC_KEY=
# Optional server hardening, OFF by default: with "no" (default) deploy.sh leaves the server's SSH configuration and
# firewall exactly as they are.
# SSH_HARDENING=yes: key-only SSH (password login off) and PermitRootLogin below, written to
#   /etc/ssh/sshd_config.d/00-amoobot-hardening.conf only once DEPLOY_USER verifiably has a key login and its sudo rule
#   (otherwise the deploy stops); SSH must listen on port 22.
# SSH_HARDENING_REVERT=yes (with SSH_HARDENING=no): remove that drop-in if an earlier deploy installed it (checked with
#   sshd -t first; password login and PermitRootLogin then come from the rest of the sshd config).
# FIREWALL=yes: ufw default deny incoming, allow only 22/80/443, enable (refused if SSH does not listen on 22).
#   With "no" ufw is not touched; open TCP 80 and 443 (and your SSH port) yourself.
SSH_HARDENING=
SSH_HARDENING_REVERT=
FIREWALL=
# Only with SSH_HARDENING=yes: "prohibit-password" (default: root only with a key) or "no" (root cannot log in over SSH
# at all). "no" is refused unless another account can log in with a key and has full sudo, or I_HAVE_CONSOLE_ACCESS=yes
# (provider console with a root password): the deploy user can only run the amoobot-* commands.
SSH_PERMIT_ROOT_LOGIN=
I_HAVE_CONSOLE_ACCESS=
# Defaults: /var/www/amoobot and 8.4. APP_DIR must be /var/www/<name> or /srv/<name>; PHP_VERSION like 8.4.
APP_DIR=
PHP_VERSION=
# Optional. Only these IPv4/IPv6 addresses or CIDR ranges may open /admin (comma separated, e.g. 203.0.113.7, 10.0.0.0/8).
# Empty (default) = no IP restriction; the login is still rate-limited. Behind a CDN/proxy nginx sees the proxy's address.
ADMIN_ALLOW_IPS=
###< server / deploy ###

###> database ###
# Local MariaDB created by deploy.sh. Defaults: amoobot / amoobot
DB_NAME=
DB_USER=
# REQUIRED unless DATABASE_URL is set. 16+ chars of A-Z a-z 0-9 . _ ~ -  (openssl rand -hex 24)
DB_PASSWORD=
# Leave EMPTY to have deploy.sh build it from DB_* (recommended). Set it only for an external database;
# then deploy.sh does not create the DB and you must set sql_mode there yourself. Inside this URL a literal
# "%" must be written as "%%" (Symfony env "resolve:" processor).
DATABASE_URL=
###< database ###

###> backups (amoobot-backup nightly via /etc/cron.d/amoobot-backup) ###
# Defaults: /var/backups/amoobot, 14 days, "30 3 * * *" (03:30 server time). BACKUP_DIR must be /var/backups/<name>
# or /srv/<name>. Retention deletes only nightly dumps; pre-deploy / pre-restore / manual dumps are kept.
# BACKUP_CRON: five fields of 0-9 * / , - only, or @daily / @hourly / @weekly (anything else stops the deploy).
BACKUP_DIR=
BACKUP_RETENTION_DAYS=
BACKUP_CRON=
###< backups ###

###> monitoring (read by deploy.sh only) ###
# Optional dead-man's-switch URL (https://, e.g. healthchecks.io). Every successful scheduled job and the nightly
# backup ping it; the monitor alerts when pings STOP (works even when Telegram is down). "{job}" is replaced by the
# job name (broadcasts, orders, sync, expiry, suspend, notifications, backup) for one check per job, e.g.
# https://hc-ping.com/<ping-key>/amoobot-{job}. Treat it as a secret: anyone with it can fake check-ins.
MONITOR_PING_URL=
###< monitoring ###

###> symfony ###
# Enforced by deploy.sh: APP_ENV=prod and APP_DEBUG=0 (any other value aborts the deploy). Leave empty or set exactly so.
APP_ENV=
APP_DEBUG=
# REQUIRED. 32+ random characters (openssl rand -hex 32). Rotating it logs out admin sessions.
APP_SECRET=
# Default from .env: fa
APP_DEFAULT_LOCALE=
# Default: https://DOMAIN
DEFAULT_URI=
###< symfony ###

###> telegram ###
# REQUIRED. From @BotFather. Revoke/regenerate there if it ever leaks.
TELEGRAM_BOT_TOKEN=
# REQUIRED. Secret path segment of the webhook URL: 32-256 chars of A-Z a-z 0-9 _ -  (openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=
# REQUIRED. Sent by Telegram in the X-Telegram-Bot-Api-Secret-Token header (setWebhook secret_token).
# Same character rules, and must differ from TELEGRAM_WEBHOOK_SECRET.
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# REQUIRED. Numeric chat id that receives admin alerts (payments needing review, errors).
TELEGRAM_ADMIN_CHAT_ID=
# Enforced: webhook (deploy.sh registers the webhook; long polling must not run in production).
TELEGRAM_MODE=
# Optional outbound proxy for api.telegram.org: socks5://host:1080 | socks5://user:pass@host:1080 | http://host:port
TELEGRAM_PROXY=
###< telegram ###

###> payment gateways ###
# Card-to-card (manual) payment details shown to customers.
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
PAYMENT_DESCRIPTION=
# Online gateways (Zibal, NOWPayments, custom API / plugin gateways) are NOT configured here: their merchant ids,
# API keys and IPN/webhook secrets live per gateway in the admin panel (Payment gateways). Before go-live set
# sandbox=false, callback_base_url=https://DOMAIN and production keys there (checklist in docs/fa/deployment.md).
###< payment gateways ###

###> panel proxy (optional, for VPN panels reachable only through a proxy) ###
PANEL_PROXY_ENABLED=
PANEL_PROXY_TYPE=
PANEL_PROXY_HOST=
PANEL_PROXY_PORT=
PANEL_PROXY_USERNAME=
PANEL_PROXY_PASSWORD=
PANEL_PROXY_TIMEOUT=
###< panel proxy ###

###> business rules (optional; empty = defaults from config/services.yaml) ###
SERVICE_NOTIFY_EXPIRY_DAYS=
SERVICE_NOTIFY_TRAFFIC_THRESHOLDS=
RENEWAL_CARRY_REMAINING_TRAFFIC=
RENEWAL_CARRY_REMAINING_DAYS=
RENEWAL_EXPIRED_START_FROM_NOW=
PRICING_GLOBAL_DISCOUNT_PERCENT=
TRAFFIC_ADDON_ENABLED=
TRAFFIC_ADDON_MIN_GB=
TRAFFIC_ADDON_MAX_GB=
TRAFFIC_ADDON_PRICE_PER_GB=
###< business rules ###

###> app downloads (optional) ###
# Largest installer an admin may upload under Apps -> Downloads, in MB (default 200, at most 2048). deploy.sh raises the
# PHP-FPM and nginx limits to match, for the upload page only (docs/fa/deployment.md, "App downloads").
APP_DOWNLOADS_MAX_MB=
# Where uploaded installers are kept, outside public/ (default: <app>/var/downloads, kept across deploys). Not in the
# database backup: back this directory up separately if you upload files rather than link to them.
APP_DOWNLOADS_DIR=
###< app downloads ###

###> branding (optional) ###
# Where the brand logo (Settings -> Branding) is kept, outside public/ (default: <app>/var/branding, kept across
# deploys). Not in the database backup: back it up with var/downloads, or upload the logo again after a restore.
APP_BRANDING_DIR=
###< branding ###
