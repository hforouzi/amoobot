{% extends ea() is null ? 'admin/custom_page.html.twig' : (admin_ui_modern() ? 'admin/modern/layout.html.twig' : '@!EasyAdmin/layout.html.twig') %}

{# The locale switcher sits next to the user menu, in the same row (it used to overlap the user's name).
   Modern layout (AdminUiMode): the locale switch is at the bottom of the sidebar instead. #}
{% block header_custom_menu_wrapper %}
{%- if admin_ui_modern() %}{{ parent() }}{% else %}
    <div class="admin-topbar-tools">
        {{ include('admin/_locale_switcher.html.twig') }}
        {{ parent() }}
    </div>
{% endif -%}
{% endblock %}
