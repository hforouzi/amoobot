{# The payment return page (PaymentReturnController): one state per page, on the shared customer layout. #}
{% extends 'public/layout.html.twig' %}

{% set tone = {paid: 'success', pending: 'pending', failed: 'danger', provision_failed: 'pending', review: 'pending', cancelled: 'neutral'}[state] ?? 'neutral' %}
{% set icon = {paid: 'check', pending: 'clock', failed: 'cross', provision_failed: 'alert', review: 'search', cancelled: 'ban'}[state] ?? 'question' %}

{% block title %}نتیجه پرداخت{% endblock %}

{% block head %}
    {% if redirectEnabled and subscriptionUrl %}
        <meta http-equiv="refresh" content="5;url={{ subscriptionUrl }}">
    {% endif %}
    {% if refreshSeconds %}
        <meta http-equiv="refresh" content="{{ refreshSeconds }}">
    {% endif %}
{% endblock %}

{% block content %}
    {% if state == 'paid' %}
        <h1>پرداخت با موفقیت تایید شد</h1>
        {% if order %}
            <dl class="summary">
                <div>
                    <dt>کد پیگیری سفارش</dt>
                    <dd class="ltr">{{ order.trackingCode ?: order.id }}</dd>
                </div>
                <div>
                    <dt>وضعیت سفارش</dt>
                    <dd>{{ order.status }}</dd>
                </div>
                {% if service %}
                    <div>
                        <dt>نام کاربری سرویس</dt>
                        <dd class="ltr">{{ service.clientEmail ?: service.username ?: '-' }}</dd>
                    </div>
                {% endif %}
            </dl>
        {% endif %}

        {% if ownedElsewhere|default(false) %}
            {# The service changed owner after this order (a transfer): the payment is done; nothing of the service is shown. #}
            <p class="lead">پرداخت انجام شد و سفارش تکمیل شده است.</p>
        {% else %}
        {% if accessWithheld|default(false) %}
            <p class="danger">لینک اشتراک این سرویس فعلاً قابل استفاده نیست. لطفاً با پشتیبانی تماس بگیرید.</p>
        {% endif %}
        {% if subscriptionUrl %}
            <p class="lead">لینک اشتراک شما آماده است.</p>
            <div class="actions">
                <a class="button" href="{{ subscriptionUrl }}">مشاهده لینک اشتراک</a>
            </div>
            {% if redirectEnabled %}
                <p class="help">تا چند ثانیه دیگر به لینک اشتراک منتقل می‌شوید.</p>
            {% endif %}
        {% elseif configText %}
            <p class="lead">لینک اشتراک برای این سرویس ثبت نشده است. کانفیگ سرویس:</p>
            <pre tabindex="0">{{ configText }}</pre>
            <p class="help">اطلاعات سرویس در تلگرام نیز ارسال می‌شود.</p>
        {% elseif not accessWithheld|default(false) %}
            <p class="lead">پرداخت تایید شد و سرویس در حال آماده‌سازی است. اطلاعات سرویس در تلگرام ارسال می‌شود.</p>
        {% endif %}
        {% endif %}
    {% elseif state == 'pending' %}
        <h1>در انتظار تایید پرداخت</h1>
        <div role="status" aria-live="polite">
            <div class="progress" aria-hidden="true"><span></span></div>
            <p class="lead">پرداخت شما هنوز توسط درگاه تایید نشده است. این صفحه هر {{ refreshSeconds }} ثانیه خودکار به‌روزرسانی می‌شود؛ نیازی به پرداخت مجدد نیست.</p>
            {% if statusText %}<p class="help">وضعیت فعلی: <span dir="auto">{{ statusText }}</span></p>{% endif %}
        </div>
        <div class="actions">
            {# The same address again (a GET): the page asks the gateway once more; nothing is submitted. #}
            <a class="button" href="{{ app.request.requestUri }}">همین حالا دوباره بررسی کن</a>
        </div>
        <p class="help">پس از تایید، اطلاعات سرویس در تلگرام هم ارسال می‌شود.</p>
    {% elseif state == 'failed' %}
        <h1>پرداخت ناموفق یا منقضی شد</h1>
        <p class="lead">این پرداخت تایید نشد. برای ادامه می‌توانید از داخل ربات دوباره اقدام کنید.</p>
        {% if statusText %}<p class="help">وضعیت: <span dir="auto">{{ statusText }}</span></p>{% endif %}
    {% elseif state == 'provision_failed' %}
        <h1>پرداخت تایید شد</h1>
        <p class="lead">پرداخت تایید شد اما آماده‌سازی سرویس کامل نشد. پشتیبانی مطلع شده است؛ نیازی به پرداخت مجدد نیست.</p>
    {% elseif state == 'review' %}
        <h1>پرداخت در حال بررسی توسط پشتیبانی است</h1>
        {% if payment and payment.latePaymentInReview %}
            <p class="lead">پرداخت شما پس از لغو یا پایان مهلت سفارش دریافت شد. پرداخت از بین نرفته؛ پشتیبانی آن را بررسی می‌کند و نتیجه در تلگرام اطلاع داده می‌شود.</p>
        {% else %}
            <p class="lead">مبلغ یا ارز دریافت‌شده با سفارش مطابقت نداشت. پرداخت شما ثبت شده و نتیجهٔ بررسی در تلگرام اطلاع داده می‌شود.</p>
        {% endif %}
    {% elseif state == 'cancelled' %}
        <h1>این سفارش لغو شده یا مهلت آن تمام شده است</h1>
        <p class="lead">پرداختی برای این سفارش تایید نشده است. اگر مبلغ را پرداخت کرده‌اید، پس از تایید درگاه برای بررسی به پشتیبانی ارسال می‌شود و از بین نمی‌رود. برای خرید جدید از داخل ربات اقدام کنید.</p>
    {% else %}
        <h1>لینک پرداخت معتبر نیست</h1>
        <p class="lead">این لینک به هیچ پرداختی تعلق ندارد یا قدیمی است. وضعیت پرداخت را از داخل ربات بررسی کنید؛ پرداخت‌های تاییدشده در تلگرام اطلاع داده می‌شوند.</p>
    {% endif %}
{% endblock %}
