{# The gateway's cancel return (PaymentReturnController::cancel / legacyCancel), on the shared customer layout. #}
{% extends 'public/layout.html.twig' %}

{% set tone = 'pending' %}
{% set icon = 'cross' %}

{% block title %}پرداخت لغو شد{% endblock %}

{% block content %}
    <h1>پرداخت لغو شد یا کامل نشد</h1>
    {% if order %}
        <dl class="summary">
            <div>
                <dt>کد پیگیری سفارش</dt>
                <dd class="ltr">{{ order.trackingCode ?: order.id }}</dd>
            </div>
        </dl>
        <p class="help">می‌توانید از داخل ربات با گزینه پیگیری سفارش ادامه دهید.</p>
    {% else %}
        <p class="help">اگر سفارش شما در ربات ثبت شده است، از همانجا پرداخت را دوباره بررسی یا تکرار کنید.</p>
    {% endif %}
{% endblock %}
