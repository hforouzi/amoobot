{# Customer pages (subscription page, its 404): mobile first, RTL in Persian, light/dark, no external assets.
   Colors are CSS variables so a Telegram Mini App can apply its theme (_script.html.twig). #}
{% trans_default_domain 'subscription' %}
{% set lang = app.request.locale == 'en' ? 'en' : 'fa' %}
<!DOCTYPE html>
<html lang="{{ lang }}" dir="{{ lang == 'fa' ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    <meta name="color-scheme" content="light dark">
    <meta name="format-detection" content="telephone=no">
    <title>{% block title %}{{ 'page.title'|trans }}{% endblock %}</title>
    <style>
        :root {
            --bg: #f4f6fb; --card: #ffffff; --fg: #111827; --muted: #6b7280; --border: #e5e7eb;
            --accent: #2563eb; --accent-fg: #ffffff; --ok: #15803d; --warn: #b45309; --bad: #b91c1c;
            --track: #e5e7eb; --code: #f3f4f6; --radius: 14px;
        }
        @media (prefers-color-scheme: dark) {
            :root {
                --bg: #0b1020; --card: #151b2e; --fg: #e5e7eb; --muted: #9ca3af; --border: #263049;
                --accent: #3b82f6; --accent-fg: #ffffff; --ok: #22c55e; --warn: #f59e0b; --bad: #f87171;
                --track: #263049; --code: #0f1528;
            }
        }
        /* Vazirmatn, self-hosted with the Mini App (public/miniapp/fonts, OFL); CSP font-src 'self'. */
        @font-face {
            font-family: Vazirmatn; font-style: normal; font-weight: 100 900; font-display: swap;
            src: url("/miniapp/fonts/Vazirmatn-wght.woff2?v=33.003") format("woff2-variations"), url("/miniapp/fonts/Vazirmatn-wght.woff2?v=33.003") format("woff2");
            unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0600-06FF, U+0750-077F,
                           U+08A0-08FF, U+200C-200F, U+2010-2027, U+2030-205E, U+20AC, U+2122, U+2212, U+FB50-FDFF, U+FE70-FEFF, U+FEFF, U+FFFD;
        }
        * { box-sizing: border-box; }
        html { -webkit-text-size-adjust: 100%; }
        body {
            margin: 0; background: var(--bg); color: var(--fg); line-height: 1.7;
            font-family: Vazirmatn, system-ui, -apple-system, "Segoe UI", Roboto, Tahoma, Arial, sans-serif;
            padding: max(16px, env(safe-area-inset-top)) 16px max(24px, env(safe-area-inset-bottom));
        }
        main { width: 100%; max-width: 560px; margin: 0 auto; display: grid; gap: 14px; }
        .card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; min-width: 0; }
        h1 { font-size: 1.25rem; margin: 0; }
        h2 { font-size: 1.05rem; margin: 0 0 10px; }
        p { margin: 0 0 8px; }
        .muted { color: var(--muted); font-size: .9rem; }
        .ltr { direction: ltr; unicode-bidi: isolate; }
        .badge { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: .85rem; font-weight: 600; color: #fff; }
        .badge.active { background: var(--ok); } .badge.expired, .badge.limited { background: var(--bad); } .badge.suspended { background: var(--warn); }
        .head { display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
        .stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-top: 12px; }
        .stat { background: var(--code); border-radius: 10px; padding: 10px; min-width: 0; }
        .stat b { display: block; font-size: 1.05rem; overflow-wrap: anywhere; }
        .bar { height: 10px; background: var(--track); border-radius: 999px; overflow: hidden; margin-top: 12px; }
        .bar span { display: block; height: 100%; background: var(--ok); border-radius: inherit; }
        .bar.high span { background: var(--warn); } .bar.full span { background: var(--bad); }
        .btn {
            display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; min-height: 46px;
            padding: 10px 14px; border: 0; border-radius: 12px; background: var(--accent); color: var(--accent-fg);
            font: inherit; font-weight: 600; text-decoration: none; cursor: pointer; text-align: center;
        }
        .btn.secondary { background: transparent; color: var(--accent); border: 1px solid var(--accent); }
        .btn.small { min-height: 40px; font-size: .92rem; }
        .row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 10px; }
        .qr { display: block; width: min(280px, 100%); height: auto; margin: 14px auto 4px; background: #fff; border-radius: 10px; }
        .url { margin-top: 10px; width: 100%; padding: 10px; border: 1px solid var(--border); border-radius: 10px; background: var(--code); color: var(--fg); font: .85rem ui-monospace, Menlo, Consolas, monospace; direction: ltr; text-align: left; }
        details { margin-top: 12px; } summary { cursor: pointer; color: var(--accent); font-weight: 600; }
        ol.configs { padding-inline-start: 18px; margin: 10px 0 0; }
        ol.configs li { margin-bottom: 10px; }
        code { display: block; background: var(--code); border-radius: 8px; padding: 8px; font: .8rem/1.6 ui-monospace, Menlo, Consolas, monospace; direction: ltr; text-align: left; overflow-wrap: anywhere; white-space: pre-wrap; }
        .apps { display: grid; gap: 10px; }
        .app { border: 1px solid var(--border); border-radius: 12px; padding: 12px; }
        .app-name { font-weight: 700; }
        .platforms { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 10px; }
        .platforms a { padding: 4px 10px; border-radius: 999px; border: 1px solid var(--border); color: var(--fg); text-decoration: none; font-size: .85rem; }
        .platforms a.current { background: var(--accent); border-color: var(--accent); color: var(--accent-fg); }
        .hint { display: none; margin-top: 10px; padding: 10px; border-radius: 10px; background: var(--code); font-size: .9rem; }
        .hint.show { display: block; }
        .notice { border-inline-start: 4px solid var(--warn); }
        .downloads { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
        .downloads li { border: 1px solid var(--border); border-radius: 12px; padding: 12px; }
        .sha { font: .72rem ui-monospace, Menlo, Consolas, monospace; overflow-wrap: anywhere; direction: ltr; text-align: left; color: var(--muted); }
        .toast { position: fixed; inset-inline: 16px; bottom: max(16px, env(safe-area-inset-bottom)); margin: 0 auto; max-width: 420px; padding: 10px 14px; border-radius: 10px; background: var(--fg); color: var(--bg); text-align: center; opacity: 0; transition: opacity .2s; pointer-events: none; }
        .toast.show { opacity: .95; }
        footer { text-align: center; }
        footer a { color: var(--muted); }
        @media (max-width: 360px) { .row, .stats { grid-template-columns: minmax(0, 1fr); } }
    </style>
</head>
<body data-platform="{{ view is defined and view.platform ? view.platform.value : "" }}">
<main>
    {% block body %}{% endblock %}
</main>
{% block scripts %}{% endblock %}
</body>
</html>
