{# A plan's inbound move block in the Mini App admin (docs/design/plan-inbound-change.md 5.6, PR P9; the web's is
   admin/inbound_move/_run.html.twig, P7): its open or last run, the counts, and the buttons valid in its state that
   this admin may press. The texts of the run are the web's (admin domain); every value is escaped by Twig; ids, inbound
   titles, states and counts only (D5). Needs: plan, moveRun (InboundMoveOverview::planRun() or null), moveProblems,
   moveEnabled, moveCan, moveRoutes; show_apply_link (default true). #}
{% trans_default_domain 'admin' %}
{% set run = moveRun %}
<section class="card" id="inbound-move" data-inbound-move-run="{{ run ? run.id : '' }}">
    <h2>{{ 'inbound_move.run.heading'|trans }}</h2>
    {% if run is null %}
        <p class="muted" data-no-run>{{ 'inbound_move.run.none'|trans }}</p>
    {% else %}
        <div class="head">
            <strong>{{ ({add: 'inbound_move.run.title_add', remove: 'inbound_move.run.title_remove'}[run.kind] ?? 'inbound_move.run.title')|trans({'%run%': run.id}) }}</strong>
            <span class="badge {{ {planned: 'order-processing', running: 'active', paused: 'limited', done: 'order-completed', cancelled: 'order-cancelled'}[run.status] ?? '' }}" data-run-status="{{ run.status }}">{{ ('inbound_move.status.' ~ run.status)|trans }}</span>
        </div>
        {% set kind_suffix = run.kind == 'primary' ? '' : '_' ~ run.kind %}
        <p class="muted small-print">{{ ('inbound_move.status_help' ~ kind_suffix ~ '.' ~ run.status)|trans }}</p>
        {% if run.pause_reason %}<p class="small-print" data-pause-reason>{{ 'inbound_move.run.pause_reason'|trans }} <bdi dir="ltr">{{ run.pause_reason }}</bdi></p>{% endif %}
        <dl class="facts">
            <div><dt>{{ ('inbound_move.run.target' ~ kind_suffix)|trans }}</dt><dd data-run-target="{{ run.target_id }}">{% if run.target_title is not null %}<bdi>{{ run.target_title }}</bdi> <span class="muted ltr">#{{ run.target_id }}</span>{% else %}{{ 'inbound_move.run.target_deleted'|trans }}{% endif %}</dd></div>
            {% if run.kind == 'primary' %}
                <div><dt>{{ 'inbound_move.run.old_inbound'|trans }}</dt><dd>{{ run.keep_old ? 'inbound_move.run.keep_old'|trans : 'inbound_move.run.grace'|trans({'%hours%': run.grace_hours}) }}</dd></div>
            {% elseif run.kind == 'remove' %}
                <div><dt>{{ 'inbound_move.run.grace_title_remove'|trans }}</dt><dd data-run-grace="{{ run.grace_hours }}">{{ 'inbound_move.run.grace_remove'|trans({'%hours%': run.grace_hours}) }}</dd></div>
            {% endif %}
            <div><dt>{{ 'inbound_move.run.started_by'|trans }}</dt><dd data-started-by>{% if run.started_by is null %}{{ 'admin.inbound_move.started_by_unknown'|trans({}, 'miniapp') }}{% else %}<bdi dir="ltr">{{ run.started_by.email ?? ('#' ~ run.started_by.id) }}</bdi>{% endif %}</dd></div>
            <div><dt>{{ 'inbound_move.run.created_at'|trans }}</dt><dd><bdi dir="ltr">{{ run.created_at }}</bdi></dd></div>
            <div><dt>{{ 'inbound_move.run.started_at'|trans }}</dt><dd><bdi dir="ltr">{{ run.started_at ?? '—' }}</bdi></dd></div>
            {% if run.finished_at %}<div><dt>{{ 'inbound_move.run.finished_at'|trans }}</dt><dd><bdi dir="ltr">{{ run.finished_at }}</bdi></dd></div>{% endif %}
        </dl>
        <div class="counts" data-run-counts>
            <p class="small-print" data-count-done="{{ run.counts.done }}">{{ ('inbound_move.count.done' ~ kind_suffix)|trans({'%n%': run.counts.done, '%planned%': run.counts.planned}) }}</p>
            <p class="small-print" data-count-failed="{{ run.counts.failed }}">{{ 'inbound_move.count.failed'|trans({'%n%': run.counts.failed, '%given_up%': run.given_up}) }}</p>
            <p class="small-print" data-count-skipped="{{ run.counts.skipped }}">{{ 'inbound_move.count.skipped'|trans({'%n%': run.counts.skipped}) }}{% if run.skipped_by_reason is not empty %}:
                {% for reason, n in run.skipped_by_reason %}<span data-skip-reason="{{ reason }}">{{ ('inbound_move.skip.' ~ reason)|trans }} ({{ n }})</span>{{ not loop.last ? 'inbound_move.separator'|trans : '' }}{% endfor %}{% endif %}</p>
            <p class="small-print" data-count-remaining="{{ run.counts.remaining }}">{{ ('inbound_move.count.remaining' ~ kind_suffix)|trans({'%count%': run.counts.remaining}) }}</p>
            {% if run.kind == 'primary' %}
                <p class="small-print" data-count-retired="{{ run.retired }}">{{ 'inbound_move.count.retired'|trans({'%count%': run.retired}) }}{% if run.waiting_retire > 0 %} · {{ 'inbound_move.count.waiting_retire'|trans({'%count%': run.waiting_retire, '%at%': run.next_retire_at}) }}{% endif %}</p>
            {% else %}
                {% if run.kind == 'remove' and run.waiting_retire > 0 %}<p class="small-print" data-count-waiting="{{ run.waiting_retire }}">{{ 'inbound_move.count.waiting_remove'|trans({'%count%': run.waiting_retire, '%at%': run.next_retire_at}) }}</p>{% endif %}
                {% if run.links_pending > 0 %}<p class="small-print" data-count-links="{{ run.links_pending }}">{{ ('inbound_move.count.links_pending' ~ kind_suffix)|trans({'%n%': run.links_pending}) }}</p>{% endif %}
            {% endif %}
            {% if run.undone > 0 or run.cancelled > 0 %}<p class="small-print">{{ ('inbound_move.count.undone_cancelled' ~ kind_suffix)|trans({'%undone%': run.undone, '%cancelled%': run.cancelled}) }}</p>{% endif %}
        </div>
        {% if run.plan_changed %}
            <p class="notice-line" data-plan-changed>⚠ {{ ((run.open ? 'inbound_move.run.plan_changed_open' : 'inbound_move.run.plan_changed') ~ kind_suffix)|trans({'%run%': run.id}) }}</p>
        {% endif %}
        {% if run.retired > 0 and run.kind == 'primary' %}
            {# Undo cannot put these back (5.4): the command line's text. #}
            <p class="muted small-print" data-undo-retired="{{ run.retired }}">{{ 'inbound_move.undo_already_retired'|trans({'%count%': run.retired, '%plan%': plan.id}) }}</p>
        {% endif %}
        <div class="row" data-run-buttons>
            {% for action in ['pause', 'resume', 'retry', 'cancel', 'undo'] %}
                {% set route = moveRoutes[action] %}
                {% if attribute(run.can, action) and (moveEnabled or action in ['pause', 'cancel']) and not (run.multi_off and action in ['resume', 'retry']) and attribute(moveCan, route) %}
                    <button type="button" class="btn small {{ {pause: 'secondary', resume: '', retry: 'secondary', cancel: 'secondary danger', undo: 'danger-solid'}[action] }}" data-action="{{ path(route, {id: plan.id}) }}" data-body='{"run":{{ run.id }}}' data-reload data-run-action="{{ action }}" data-admin-action="inbound_move_{{ action }}">{{ ('inbound_move.action.' ~ action)|trans }}</button>
                {% endif %}
            {% endfor %}
        </div>
        {% if moveEnabled and not run.multi_off and (run.can.resume or run.can.retry) %}
            <p class="muted small-print" data-due-hint>{{ 'admin.inbound_move.due_hint'|trans({}, 'miniapp') }}</p>
        {% endif %}
        {% if not moveEnabled and (run.can.resume or run.can.retry or run.can.undo) %}
            <p class="muted small-print" data-switch-off-buttons>{{ 'inbound_move.run.switch_off_buttons'|trans }}</p>
        {% elseif run.multi_off and (run.can.resume or run.can.retry) %}
            <p class="muted small-print" data-multi-off-buttons>{{ 'inbound_move.run.switch_off_multi'|trans }}</p>
        {% endif %}
    {% endif %}
    {% if moveProblems.failed > 0 %}
        <p class="notice-line" data-move-problems="{{ moveProblems.failed }}/{{ moveProblems.given_up }}">{{ 'inbound_move.problems'|trans({'%failed%': moveProblems.failed, '%given_up%': moveProblems.given_up}) }}</p>
    {% endif %}
    {% if (show_apply_link ?? true) and moveCan.miniapp_admin_plan_apply_inbounds %}
        <a class="btn secondary small" href="{{ path('miniapp_admin_plan_apply_inbounds', {id: plan.id}) }}" data-nav data-apply-link>{{ 'inbound_move.apply.link'|trans }}</a>
    {% endif %}
</section>
