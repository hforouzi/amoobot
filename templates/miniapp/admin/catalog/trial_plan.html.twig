{% extends 'miniapp/view/_base.html.twig' %}
{% import 'miniapp/admin/catalog/_fields.html.twig' as f %}
{% trans_default_domain 'miniapp' %}
{% set isNew = trial.id is null %}
{% block section %}admin{% endblock %}
{% block title %}{{ isNew ? 'admin.trial.new'|trans : trial.title }}{% endblock %}
{% block attributes %} data-back data-main-button-text="{{ 'admin.form.save'|trans }}" data-main-button-form="trial-form"{% if not isNew %} data-trial-id="{{ trial.id }}"{% endif %}{% endblock %}
{% block content %}
    <form id="trial-form" class="form" novalidate
          data-submit="{{ isNew ? path('miniapp_admin_trial_plan_create') : path('miniapp_admin_trial_plan_update', {id: trial.id}) }}"
          data-check-url="{{ path('miniapp_admin_trial_plan_check') }}" data-dirty-guard="{{ 'admin.form.leave_unsaved'|trans }}"{% if not isNew %} data-reload{% endif %}>
        {% if not isNew %}<input type="hidden" name="id" value="{{ trial.id }}">{% endif %}
        {{ f.section('basics', true) }}{{ 'admin.plan.section.basics'|trans }}</summary>
            {{ f.text('title', values.title ?? '', true, null, 'maxlength="255"') }}
            {{ f.textarea('description', values.description ?? null, null) }}
            {{ f.toggle('isActive', values.isActive ?? true, null) }}
            {{ f.number('sortOrder', values.sortOrder ?? 0, true, null, null) }}
        </details>
        {{ f.section('service', true) }}{{ 'admin.trial.section.service'|trans }}</summary>
            {{ f.number('durationDays', values.durationDays ?? 1, true, null, 'admin.plan.days_suffix'|trans) }}
            {{ f.number('trafficGb', values.trafficGb ?? null, false, null, 'GB') }}
            {{ f.number('ipLimit', values.ipLimit ?? null, false, 'help.trial_plan.ip_limit', null) }}
            {{ f.inbound('inbound', values.inbound ?? null, inbounds) }}
        </details>
        {{ f.section('limits', true) }}{{ 'admin.trial.section.limits'|trans }}</summary>
            {{ f.number('maxClaimsTotal', values.maxClaimsTotal ?? null, false, 'help.trial_plan.max_claims_total', null) }}
            {{ f.number('maxClaimsPerUser', values.maxClaimsPerUser ?? 1, true, null, null) }}
            {{ f.number('cooldownHours', values.cooldownHours ?? null, false, 'help.trial_plan.cooldown_hours', null) }}
        </details>
        <p class="field-error" data-form-error hidden></p>
        <button type="submit" class="btn" data-save>{{ 'admin.form.save'|trans }}</button>
    </form>
    {% if not isNew %}
        <section class="card">
            {% if trial.active %}
                <button type="button" class="btn secondary small" data-action="{{ path('miniapp_admin_trial_plan_deactivate', {id: trial.id}) }}" data-reload data-admin-action="deactivate">⏸ {{ 'admin.plan.deactivate'|trans }}</button>
            {% else %}
                <button type="button" class="btn secondary small" data-action="{{ path('miniapp_admin_trial_plan_activate', {id: trial.id}) }}" data-reload data-admin-action="activate">▶️ {{ 'admin.plan.activate'|trans }}</button>
            {% endif %}
        </section>
    {% endif %}
{% endblock %}
