{% extends 'miniapp/view/_base.html.twig' %}
{% trans_default_domain 'miniapp' %}
{% block section %}services{% endblock %}
{% block title %}{{ 'nav.services'|trans }}{% endblock %}
{% block content %}
    <section class="card">
        <h1>{{ 'services.title'|trans }}</h1>
        {% if cards is empty %}
            <div data-no-services>
                <p class="muted">{{ 'home.get_service'|trans }}</p>
                <div class="row" style="margin-top:10px">
                    <a class="btn small" href="{{ path('miniapp_shop') }}" data-nav data-shop-link>🛒 {{ 'home.open_shop'|trans }}</a>
                    <a class="btn secondary small" href="{{ path('miniapp_help', {topic: 'connect'}) }}" data-nav data-guide-link>📖 {{ 'home.open_guide'|trans }}</a>
                </div>
            </div>
        {% endif %}
    </section>
    {% if cards is not empty %}
        <div class="list">
            {% for card in cards %}
                {{ include('miniapp/view/_service_card.html.twig', {card: card}) }}
            {% endfor %}
        </div>
    {% endif %}
    {% if wallet_enabled() %}<a class="btn secondary small" href="{{ path('miniapp_wallet') }}" data-nav data-wallet-link>👛 {{ 'wallet.title'|trans }}</a>{% endif %}
    <a class="btn secondary small" href="{{ path('miniapp_orders') }}" data-nav data-orders-link>🧾 {{ 'orders.link'|trans }}</a>
{% endblock %}
