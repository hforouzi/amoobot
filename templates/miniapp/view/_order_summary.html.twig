{# What an order is and costs, from its own price snapshot. #}
{% trans_default_domain 'miniapp' %}
<section class="card">
    <div class="head">
        <h2>{{ ('order.type.' ~ summary.type)|trans }}</h2>
        {% if order.trackingCode %}<span class="muted">{{ 'order.tracking_code'|trans }}: <b class="ltr" data-tracking-code>{{ order.trackingCode }}</b></span>{% endif %}
    </div>
    {% if summary.plan %}{# A wallet top-up has no plan, traffic or duration. #}
    <p class="muted">
        {{ summary.plan }}
        {% if summary.trafficGb %} · {{ 'plan.traffic'|trans({'%gb%': summary.trafficGb}) }}{% endif %}
        {% if summary.type != 'add_traffic' %} · {{ summary.unlimitedDuration or not summary.durationDays ? 'plan.duration_unlimited'|trans : 'plan.duration'|trans({'%days%': summary.durationDays}) }}{% endif %}
    </p>
    {% endif %}
    <dl class="price-lines">
        <div><dt>{{ 'price.base'|trans }}</dt><dd>{{ 'money.toman'|trans({'%amount%': summary.baseAmount|number_format}) }}</dd></div>
        {% if summary.globalDiscountAmount > 0 %}
            <div><dt>{{ 'price.global_discount'|trans }}</dt><dd>− {{ 'money.toman'|trans({'%amount%': summary.globalDiscountAmount|number_format}) }}</dd></div>
        {% endif %}
        {% if summary.discountCode %}
            <div><dt>{{ 'price.discount_code'|trans({'%code%': summary.discountCode}) }}</dt><dd>− {{ 'money.toman'|trans({'%amount%': summary.discountAmount|number_format}) }}</dd></div>
        {% endif %}
        <div class="total"><dt>{{ 'price.total'|trans }}</dt><dd>{{ 'money.toman'|trans({'%amount%': summary.finalAmount|number_format}) }}</dd></div>
    </dl>
</section>
