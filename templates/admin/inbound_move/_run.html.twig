{# The run block of a plan (docs/design/plan-inbound-change.md 5.6, PR P7): its open or last run, the counts and the
   buttons valid now. Rendered on the plan's detail page (PlanCrudController) and on the Apply page. Every value is
   escaped by Twig; ids, inbound titles, states and counts only (D5). Needs: plan, run (InboundMoveOverview::planRun()
   or null), problems, enabled. #}
{% trans_default_domain 'admin' %}
<div class="admin-inbound-move" id="inbound-move" data-inbound-move-run="{{ run ? run.id : '' }}">
    {% if run is null %}
        <p class="mb-2" data-no-run>{{ 'inbound_move.run.none'|trans }}</p>
    {% else %}
        <p class="mb-1">
            <strong>{{ ({add: 'inbound_move.run.title_add', remove: 'inbound_move.run.title_remove'}[run.kind] ?? 'inbound_move.run.title')|trans({'%run%': run.id}) }}</strong>
            <span class="badge badge-{{ {planned: 'info', running: 'primary', paused: 'warning', done: 'success', cancelled: 'secondary'}[run.status] ?? 'secondary' }}" data-run-status="{{ run.status }}">{{ ('inbound_move.status.' ~ run.status)|trans }}</span>
        </p>
        {% set kind_suffix = run.kind == 'primary' ? '' : '_' ~ run.kind %}
        <p class="form-text mb-1">{{ ('inbound_move.status_help' ~ kind_suffix ~ '.' ~ run.status)|trans }}</p>
        {% if run.pause_reason %}<p class="mb-1" data-pause-reason>{{ 'inbound_move.run.pause_reason'|trans }} <bdi dir="ltr">{{ run.pause_reason }}</bdi></p>{% endif %}
        <dl class="row mb-1 admin-inbound-move-facts">
            <dt class="col-sm-4">{{ ('inbound_move.run.target' ~ kind_suffix)|trans }}</dt>
            <dd class="col-sm-8" data-run-target="{{ run.target_id }}">{% if run.target_title is not null %}<bdi>{{ run.target_title }}</bdi> (#{{ run.target_id }}){% else %}{{ 'inbound_move.run.target_deleted'|trans }}{% endif %}</dd>
            {% if run.kind == 'primary' %}
                <dt class="col-sm-4">{{ 'inbound_move.run.old_inbound'|trans }}</dt>
                <dd class="col-sm-8">{{ run.keep_old ? 'inbound_move.run.keep_old'|trans : 'inbound_move.run.grace'|trans({'%hours%': run.grace_hours}) }}</dd>
            {% elseif run.kind == 'remove' %}
                <dt class="col-sm-4">{{ 'inbound_move.run.grace_title_remove'|trans }}</dt>
                <dd class="col-sm-8" data-run-grace="{{ run.grace_hours }}">{{ 'inbound_move.run.grace_remove'|trans({'%hours%': run.grace_hours}) }}</dd>
            {% endif %}
            <dt class="col-sm-4">{{ 'inbound_move.run.started_by'|trans }}</dt>
            <dd class="col-sm-8" data-started-by>{% if run.started_by is null %}{{ 'inbound_move.run.command_line'|trans }}{% else %}<bdi dir="ltr">{{ run.started_by.email ?? ('#' ~ run.started_by.id) }}</bdi>{% endif %}</dd>
            <dt class="col-sm-4">{{ 'inbound_move.run.created_at'|trans }}</dt>
            <dd class="col-sm-8"><bdi dir="ltr">{{ run.created_at }}</bdi></dd>
            <dt class="col-sm-4">{{ 'inbound_move.run.started_at'|trans }}</dt>
            <dd class="col-sm-8"><bdi dir="ltr">{{ run.started_at ?? '—' }}</bdi></dd>
            {% if run.finished_at %}
                <dt class="col-sm-4">{{ 'inbound_move.run.finished_at'|trans }}</dt>
                <dd class="col-sm-8"><bdi dir="ltr">{{ run.finished_at }}</bdi></dd>
            {% endif %}
        </dl>
        <ul class="list-unstyled mb-2" data-run-counts>
            <li data-count-done="{{ run.counts.done }}">{{ ('inbound_move.count.done' ~ kind_suffix)|trans({'%n%': run.counts.done, '%planned%': run.counts.planned}) }}</li>
            <li data-count-failed="{{ run.counts.failed }}">{{ 'inbound_move.count.failed'|trans({'%n%': run.counts.failed, '%given_up%': run.given_up}) }}</li>
            <li data-count-skipped="{{ run.counts.skipped }}">{{ 'inbound_move.count.skipped'|trans({'%n%': run.counts.skipped}) }}{% if run.skipped_by_reason is not empty %}:
                {% for reason, n in run.skipped_by_reason %}<span class="text-nowrap" data-skip-reason="{{ reason }}">{{ ('inbound_move.skip.' ~ reason)|trans }} ({{ n }})</span>{{ not loop.last ? 'inbound_move.separator'|trans : '' }}{% endfor %}{% endif %}</li>
            <li data-count-remaining="{{ run.counts.remaining }}">{{ ('inbound_move.count.remaining' ~ kind_suffix)|trans({'%count%': run.counts.remaining}) }}</li>
            {% if run.kind == 'primary' %}
                <li data-count-retired="{{ run.retired }}">{{ 'inbound_move.count.retired'|trans({'%count%': run.retired}) }}{% if run.waiting_retire > 0 %} · {{ 'inbound_move.count.waiting_retire'|trans({'%count%': run.waiting_retire, '%at%': run.next_retire_at}) }}{% endif %}</li>
            {% else %}
                {% if run.kind == 'remove' and run.waiting_retire > 0 %}<li data-count-waiting="{{ run.waiting_retire }}">{{ 'inbound_move.count.waiting_remove'|trans({'%count%': run.waiting_retire, '%at%': run.next_retire_at}) }}</li>{% endif %}
                {% if run.links_pending > 0 %}<li data-count-links="{{ run.links_pending }}">{{ ('inbound_move.count.links_pending' ~ kind_suffix)|trans({'%n%': run.links_pending}) }}</li>{% endif %}
            {% endif %}
            {% if run.undone > 0 or run.cancelled > 0 %}<li>{{ ('inbound_move.count.undone_cancelled' ~ kind_suffix)|trans({'%undone%': run.undone, '%cancelled%': run.cancelled}) }}</li>{% endif %}
        </ul>
        {% if run.plan_changed %}
            <p class="alert alert-warning py-2" data-plan-changed>{{ ((run.open ? 'inbound_move.run.plan_changed_open' : 'inbound_move.run.plan_changed') ~ kind_suffix)|trans({'%run%': run.id}) }}</p>
        {% endif %}
        {% if run.retired > 0 and run.kind == 'primary' %}
            {# Undo cannot put these back (5.4): the command line's text. #}
            <p class="form-text" data-undo-retired="{{ run.retired }}">{{ 'inbound_move.undo_already_retired'|trans({'%count%': run.retired, '%plan%': plan.id}) }}</p>
        {% endif %}
        <div class="d-flex flex-wrap gap-2 mb-2" data-run-buttons>
            {% for action in ['pause', 'resume', 'retry', 'cancel', 'undo'] %}
                {% if attribute(run.can, action) and (enabled or action in ['pause', 'cancel']) and not (run.multi_off and action in ['resume', 'retry']) %}
                    <form method="post" action="{{ path('admin_inbound_move_run_action', {id: run.id, action: action}) }}" data-run-action="{{ action }}"{% if action in ['cancel', 'undo'] %} onsubmit="return confirm('{{ ('inbound_move.confirm.' ~ action ~ kind_suffix)|trans|e('js') }}')"{% endif %}>
                        <input type="hidden" name="_token" value="{{ csrf_token('inbound-move-run-' ~ run.id) }}">
                        <button type="submit" class="btn btn-sm {{ {pause: 'btn-secondary', resume: 'btn-primary', retry: 'btn-warning', cancel: 'btn-outline-danger', undo: 'btn-danger'}[action] }}">{{ ('inbound_move.action.' ~ action)|trans }}</button>
                    </form>
                {% endif %}
            {% endfor %}
        </div>
        {% if not enabled and (run.can.resume or run.can.retry or run.can.undo) %}
            <p class="form-text" data-switch-off-buttons>{{ 'inbound_move.run.switch_off_buttons'|trans }}</p>
        {% elseif run.multi_off and (run.can.resume or run.can.retry) %}
            <p class="form-text" data-multi-off-buttons>{{ 'inbound_move.run.switch_off_multi'|trans }}</p>
        {% endif %}
    {% endif %}
    {% if problems.failed > 0 %}
        <p class="text-warning mb-2" data-move-problems="{{ problems.failed }}/{{ problems.given_up }}">{{ 'inbound_move.problems'|trans({'%failed%': problems.failed, '%given_up%': problems.given_up}) }}</p>
    {% endif %}
    {% if show_apply_link ?? true %}
        <a class="btn btn-sm btn-outline-primary" href="{{ path('admin_plan_apply_inbounds', {id: plan.id}) }}" data-apply-link>{{ 'inbound_move.apply.link'|trans }}</a>
    {% endif %}
</div>
