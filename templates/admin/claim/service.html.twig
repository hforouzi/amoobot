{# ClaimAdminController::service: one service's claim links and ownership history; (SERVICES_MANAGE) make a link, revoke,
   return to the reseller who sold it. A new link's token is on the answer page of its creation only. #}
{% extends '@EasyAdmin/page/content.html.twig' %}
{% trans_default_domain 'admin' %}
{% set canManage = is_granted('PERM_SERVICES_MANAGE') %}

{% block content_title %}{{ 'claim_admin.service_title'|trans({'%id%': service.id}) }}{% endblock %}

{% block main %}
    <div class="admin-custom-page admin-claim-service-page" data-service-id="{{ service.id }}">
        {% if not enabled %}<p class="alert alert-warning" data-claims-off>{{ 'claim_admin.feature_off'|trans }}</p>{% endif %}
        <dl class="admin-form-card">
            <dt>{{ 'claim_admin.fields.owner'|trans }}</dt><dd data-owner="{{ service.user.id }}">{{ service.user.name ?? ('#' ~ service.user.id) }}</dd>
            <dt>{{ 'claim_admin.fields.sold_by'|trans }}</dt><dd>{% if service.soldByReseller %}<a href="{{ path('admin_reseller', {id: service.soldByReseller.id}) }}">{{ service.soldByReseller }}</a>{% else %}—{% endif %}</dd>
            <dt>{{ 'claim_admin.fields.status'|trans }}</dt><dd>{{ service.status }}</dd>
        </dl>

        {% if created %}
            <div class="alert alert-success" data-created-link>
                <p><strong>{{ 'claim_admin.created.title'|trans }}</strong></p>
                {% if created.botLink %}
                    <p><bdi dir="ltr"><code data-link>{{ created.botLink }}</code></bdi></p>
                {% else %}
                    <p>{{ 'claim_admin.created.no_link'|trans }} <bdi dir="ltr"><code data-link>/start {{ created.payload }}</code></bdi></p>
                {% endif %}
                {% if created.appLink %}<p>{{ 'claim_admin.created.app'|trans }} <bdi dir="ltr"><code>{{ created.appLink }}</code></bdi></p>{% endif %}
                <p class="form-text">{{ 'claim_admin.created.help'|trans({'%until%': created.claim.expiresAt|date('Y-m-d H:i')}) }}</p>
            </div>
        {% endif %}

        {% if canManage %}
            <div class="admin-form-card">
                <h2>{{ 'claim_admin.create.title'|trans }}</h2>
                {% if claimProblem is null %}
                    <p class="form-text">{{ 'claim_admin.create.help'|trans }}</p>
                    <form method="post" action="{{ path('admin_claims_create', {id: service.id}) }}" data-create-link-form>
                        <input type="hidden" name="_token" value="{{ csrf_token(csrf) }}">
                        <button type="submit" class="btn btn-primary">{{ 'claim_admin.create.submit'|trans }}</button>
                    </form>
                {% else %}
                    <p class="text-muted" data-not-claimable="{{ claimProblem }}">{{ ('claim_admin.problem.' ~ claimProblem)|trans }}</p>
                {% endif %}
            </div>
            {% if returnProblem is null %}
                <form method="post" action="{{ path('admin_claims_return', {id: service.id}) }}" class="admin-form-card" data-return-form>
                    <h2>{{ 'claim_admin.return.title'|trans }}</h2>
                    <p class="form-text">{{ 'claim_admin.return.help'|trans }}</p>
                    <input type="hidden" name="_token" value="{{ csrf_token(csrf) }}">
                    <div class="admin-form-row">
                        <label class="form-label" for="reason">{{ 'claim_admin.return.reason'|trans }}</label>
                        <input class="form-control" type="text" id="reason" name="reason" minlength="3" maxlength="255" required>
                    </div>
                    <div class="admin-actions"><button type="submit" class="btn btn-danger">{{ 'claim_admin.return.submit'|trans }}</button></div>
                </form>
            {% endif %}
        {% endif %}

        <div class="admin-form-card" data-claims>
            <h2>{{ 'claim_admin.links_title'|trans }}</h2>
            {% if claims is empty %}
                <p class="text-muted">{{ 'claim_admin.empty'|trans }}</p>
            {% else %}
                <table class="table datagrid">
                    <thead><tr><th>#</th><th>{{ 'claim_admin.fields.made_by'|trans }}</th><th>{{ 'claim_admin.fields.status'|trans }}</th><th>{{ 'claim_admin.fields.created'|trans }}</th><th>{{ 'claim_admin.fields.expires'|trans }}</th><th>{{ 'claim_admin.fields.claimed_by'|trans }}</th><th>{{ 'claim_admin.fields.panel'|trans }}</th><th></th></tr></thead>
                    <tbody>
                    {% for claim in claims %}
                        <tr data-claim-id="{{ claim.id }}" data-status="{{ claim.status }}">
                            <td>{{ claim.id }}</td>
                            <td>{% if claim.reseller %}{{ claim.reseller }}{% else %}{{ 'claim_admin.made_by_admin'|trans({'%id%': claim.createdByAdminId ?? '-'}) }}{% endif %}</td>
                            <td>{{ ('claim_admin.status.' ~ claim.status)|trans }}{% if claim.revokeReason %} <span class="text-muted">({{ ('claim_admin.revoke_reason.' ~ claim.revokeReason)|trans }})</span>{% endif %}</td>
                            <td>{{ claim.createdAt|date('Y-m-d H:i') }}</td>
                            <td>{{ claim.expiresAt|date('Y-m-d H:i') }}</td>
                            <td>{% if claim.claimedByUser %}{{ claim.claimedByUser.name ?? ('#' ~ claim.claimedByUser.id) }} <bdi class="text-muted">{{ claim.claimedByTelegramId }}</bdi> · {{ claim.claimedAt|date('Y-m-d H:i') }}{% else %}—{% endif %}</td>
                            <td>{% if claim.panelSyncStatus %}<span data-panel-sync="{{ claim.panelSyncStatus }}" title="{{ claim.panelSyncError }}">{{ ('claim_admin.panel_sync.' ~ claim.panelSyncStatus)|trans }}</span>{% else %}—{% endif %}</td>
                            <td>
                                {% if canManage and claim.open %}
                                    <form method="post" action="{{ path('admin_claim_revoke', {id: claim.id}) }}" data-revoke-form>
                                        <input type="hidden" name="_token" value="{{ csrf_token(csrf) }}">
                                        <button type="submit" class="btn btn-sm btn-secondary">{{ 'claim_admin.revoke'|trans }}</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>

        <div class="admin-form-card" data-ownership-history>
            <h2>{{ 'claim_admin.history_title'|trans }}</h2>
            {% if events is empty %}
                <p class="text-muted">{{ 'claim_admin.history_empty'|trans }}</p>
            {% else %}
                <table class="table datagrid">
                    <thead><tr><th>{{ 'claim_admin.fields.when'|trans }}</th><th>{{ 'claim_admin.fields.from'|trans }}</th><th>{{ 'claim_admin.fields.to'|trans }}</th><th>{{ 'claim_admin.fields.how'|trans }}</th><th>{{ 'claim_admin.fields.reason'|trans }}</th></tr></thead>
                    <tbody>
                    {% for event in events %}
                        <tr data-event-id="{{ event.id }}" data-actor="{{ event.actorType }}">
                            <td>{{ event.createdAt|date('Y-m-d H:i') }}</td>
                            <td>{{ event.fromUser.name ?? ('#' ~ event.fromUser.id) }}</td>
                            <td>{{ event.toUser.name ?? ('#' ~ event.toUser.id) }}</td>
                            <td>{% if event.claim %}{{ 'claim_admin.how.claim'|trans({'%id%': event.claim.id}) }}{% else %}{{ ('claim_admin.how.' ~ event.actorType)|trans({'%id%': event.actorAdminId ?? '-'}) }}{% endif %}</td>
                            <td>{{ event.reason ?? '—' }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
{% endblock %}
