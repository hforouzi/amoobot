{# ResellerAdminController::refund, first step: what the refund will do; only "Confirm" writes it. #}
{% extends '@EasyAdmin/page/content.html.twig' %}
{% trans_default_domain 'admin' %}
{% set toman = ('currency.' ~ constant('App\\Payment\\Domain\\Money\\AmountNormalizer::SHOP_CURRENCY'))|trans %}

{% block content_title %}{{ 'reseller_admin.refund.confirm_title'|trans }}{% endblock %}

{% block main %}
    <div class="admin-custom-page" data-refund-confirm>
        <div class="admin-form-card">
            <p>{{ 'reseller_admin.refund.confirm'|trans({'%amount%': amount|number_format, '%paid%': paid|number_format, '%order%': order.id, '%reseller%': reseller.user.name ?? ('#' ~ reseller.user.id), '%currency%': toman}) }}</p>
            <p>{{ 'reseller_admin.refund.reason'|trans }}: {{ reason }}</p>
            <form method="post" action="{{ path('admin_reseller_order_refund', {orderId: order.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token(csrf) }}">
                <input type="hidden" name="amount" value="{{ amount }}">
                <input type="hidden" name="reason" value="{{ reason }}">
                <input type="hidden" name="confirmed" value="1">
                <div class="admin-actions">
                    <button type="submit" class="btn btn-primary" data-confirm-refund>{{ 'reseller_admin.refund.submit'|trans }}</button>
                    <a class="btn btn-secondary" href="{{ path('admin_reseller', {id: reseller.id}) }}">{{ 'common.cancel'|trans }}</a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
