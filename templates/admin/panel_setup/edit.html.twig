{% extends '@EasyAdmin/page/content.html.twig' %}
{% trans_default_domain 'admin' %}

{% block content_title %}{{ (is_new ? 'panel_connection.title_new' : 'panel_connection.title_edit')|trans }}{% endblock %}

{% block main %}
    <div class="admin-custom-page">
        {% include 'admin/panel_setup/_steps.html.twig' with {current: 1} %}
        <p class="text-muted">{{ 'panel_connection.intro'|trans }}</p>

        {{ form_start(form, {attr: {class: 'admin-form-card', novalidate: 'novalidate'}}) }}
            {{ form_row(form.title) }}
            {{ form_row(form.baseUrl) }}
            {{ form_row(form.plainApiToken) }}
            {% if token_mask %}
                <p class="form-text">{{ 'panel_connection.form.token_kept'|trans({'%mask%': token_mask}) }}</p>
            {% endif %}
            {{ form_row(form.isActive) }}

            {% if form.username is defined %}
                <fieldset class="admin-form-card mt-3" id="legacy-credentials">
                    <legend class="h6">{{ 'panel_connection.form.legacy_credentials'|trans }}</legend>
                    <p class="form-text">{{ 'panel_connection.form.legacy_credentials_help'|trans }}</p>
                    {{ form_row(form.username) }}
                    {{ form_row(form.plainPassword) }}
                    {% if password_configured %}
                        <p class="form-text">{{ 'panel_connection.form.password_kept'|trans }}</p>
                    {% endif %}
                    {{ form_row(form.apiVersion) }}
                    {{ form_row(form.authMode) }}
                    {{ form_row(form.clientApiMode) }}
                    {{ form_row(form.basePath) }}
                </fieldset>
            {% endif %}

            {% set advanced = [form.useProxy, form.tlsPin, form.integrationModeValue, form.subscriptionBaseUrl, form.subscriptionPathPrefix, form.publicHost] %}
            <details class="mt-3 mb-3" {{ advanced|filter(f => f.vars.errors|length)|length ? 'open' }}>
                <summary>{{ 'panel_connection.form.advanced'|trans }}</summary>
                <div class="mt-2">
                    {{ form_row(form.subscriptionBaseUrl) }}
                    {{ form_row(form.subscriptionPathPrefix) }}
                    {{ form_row(form.useProxy) }}
                    {{ form_row(form.tlsPin) }}
                    {{ form_row(form.integrationModeValue) }}
                    {{ form_row(form.publicHost) }}
                </div>
            </details>

            <button type="submit" class="btn btn-primary">{{ 'panel_connection.form.save'|trans }}</button>
            {% if not is_new %}
                <a class="btn btn-link" href="{{ path('admin_panel_setup_show', {id: panel.id}) }}">{{ 'panel_connection.back'|trans }}</a>
            {% endif %}
        {{ form_end(form) }}
    </div>
{% endblock %}
