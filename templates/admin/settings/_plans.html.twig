{# Settings page, "plans" tab: the switch for plans with several inbounds (docs/design/multi-inbound-plans.md 6). #}
{% trans_default_domain 'admin' %}
    <p class="admin-page-subtitle">{{ 'plan_settings.subtitle'|trans }}</p>

    <form method="post" action="{{ path('admin_settings', {tab: 'plans'}) }}" class="admin-form-card admin-settings-form">
        <div class="admin-section">
            <h2>{{ 'plan_settings.sections.multi_inbound'|trans }}</h2>
            <div class="admin-checkbox-row">
                <input type="checkbox" id="plans_multi_inbound_enabled" name="plans_multi_inbound_enabled" {% if values.plans_multi_inbound_enabled %}checked{% endif %}>
                <label for="plans_multi_inbound_enabled">{{ 'plan_settings.fields.multi_inbound_enabled'|trans }}</label>
            </div>
            <div class="form-text">{{ 'plan_settings.help.multi_inbound_enabled'|trans }}</div>
        </div>

        <div class="admin-section">
            <h2>{{ 'plan_settings.sections.attach_retry'|trans }}</h2>
            <div class="admin-checkbox-row">
                <input type="checkbox" id="plans_attach_retry_enabled" name="plans_attach_retry_enabled" {% if values.plans_attach_retry_enabled %}checked{% endif %}>
                <label for="plans_attach_retry_enabled">{{ 'plan_settings.fields.attach_retry_enabled'|trans }}</label>
            </div>
            <div class="form-text">{{ 'plan_settings.help.attach_retry_enabled'|trans }}</div>
            <div class="admin-form-grid">
                <div class="admin-form-row">
                    <label class="form-label" for="plans_attach_max_attempts">{{ 'plan_settings.fields.attach_max_attempts'|trans }}</label>
                    <input class="form-control" type="number" min="1" max="{{ constant('App\\Shop\\Application\\MultiInboundSettings::MAX_MAX_ATTEMPTS') }}" step="1" dir="ltr" id="plans_attach_max_attempts" name="plans_attach_max_attempts" value="{{ values.plans_attach_max_attempts }}">
                    <div class="form-text">{{ 'plan_settings.help.attach_max_attempts'|trans }}</div>
                </div>
                <div class="admin-form-row">
                    <label class="form-label" for="plans_attach_retry_delay_minutes">{{ 'plan_settings.fields.attach_retry_delay_minutes'|trans }}</label>
                    <input class="form-control" type="number" min="1" max="{{ constant('App\\Shop\\Application\\MultiInboundSettings::MAX_RETRY_DELAY_MINUTES') }}" step="1" dir="ltr" id="plans_attach_retry_delay_minutes" name="plans_attach_retry_delay_minutes" value="{{ values.plans_attach_retry_delay_minutes }}">
                    <div class="form-text">{{ 'plan_settings.help.attach_retry_delay_minutes'|trans }}</div>
                </div>
            </div>
        </div>

        {# docs/design/plan-inbound-change.md 8.1. P3: the keys only; nothing reads them yet. #}
        <div class="admin-section">
            <h2>{{ 'plan_settings.sections.inbound_move'|trans }}</h2>
            <div class="alert alert-info" role="note">{{ 'plan_settings.help.inbound_move_not_active'|trans }}</div>
            <div class="admin-checkbox-row">
                <input type="checkbox" id="plans_inbound_move_enabled" name="plans_inbound_move_enabled" {% if values.plans_inbound_move_enabled %}checked{% endif %}>
                <label for="plans_inbound_move_enabled">{{ 'plan_settings.fields.inbound_move_enabled'|trans }}</label>
            </div>
            <div class="form-text">{{ 'plan_settings.help.inbound_move_enabled'|trans }}</div>
            <div class="admin-form-grid">
                <div class="admin-form-row">
                    <label class="form-label" for="plans_inbound_move_detach_grace_hours">{{ 'plan_settings.fields.inbound_move_detach_grace_hours'|trans }}</label>
                    <input class="form-control" type="number" min="{{ constant('App\\Shop\\Application\\InboundMoveSettings::MIN_DETACH_GRACE_HOURS') }}" max="{{ constant('App\\Shop\\Application\\InboundMoveSettings::MAX_DETACH_GRACE_HOURS') }}" step="1" dir="ltr" id="plans_inbound_move_detach_grace_hours" name="plans_inbound_move_detach_grace_hours" value="{{ values.plans_inbound_move_detach_grace_hours }}">
                    <div class="form-text">{{ 'plan_settings.help.inbound_move_detach_grace_hours'|trans }}</div>
                </div>
                <div class="admin-form-row">
                    <label class="form-label" for="plans_inbound_move_batch_size">{{ 'plan_settings.fields.inbound_move_batch_size'|trans }}</label>
                    <input class="form-control" type="number" min="{{ constant('App\\Shop\\Application\\InboundMoveSettings::MIN_BATCH_SIZE') }}" max="{{ constant('App\\Shop\\Application\\InboundMoveSettings::MAX_BATCH_SIZE') }}" step="1" dir="ltr" id="plans_inbound_move_batch_size" name="plans_inbound_move_batch_size" value="{{ values.plans_inbound_move_batch_size }}">
                    <div class="form-text">{{ 'plan_settings.help.inbound_move_batch_size'|trans }}</div>
                </div>
                <div class="admin-form-row">
                    <label class="form-label" for="plans_inbound_move_pause_seconds">{{ 'plan_settings.fields.inbound_move_pause_seconds'|trans }}</label>
                    <input class="form-control" type="number" min="{{ constant('App\\Shop\\Application\\InboundMoveSettings::MIN_PAUSE_SECONDS') }}" max="{{ constant('App\\Shop\\Application\\InboundMoveSettings::MAX_PAUSE_SECONDS') }}" step="1" dir="ltr" id="plans_inbound_move_pause_seconds" name="plans_inbound_move_pause_seconds" value="{{ values.plans_inbound_move_pause_seconds }}">
                    <div class="form-text">{{ 'plan_settings.help.inbound_move_pause_seconds'|trans }}</div>
                </div>
            </div>
        </div>

        <div class="admin-actions">
            <button type="submit" class="btn btn-primary">{{ 'common.save'|trans }}</button>
        </div>
    </form>
